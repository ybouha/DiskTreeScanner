<Project>
  <!-- Shared settings for every project of the solution. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <TieredPGO>true</TieredPGO>
    <Deterministic>true</Deterministic>
    <!-- Symbols inside the assemblies: no .pdb files to ship, stack traces keep their line numbers. -->
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>DiskTreeScanner</Product>
    <Company>DiskTreeScanner</Company>
    <Copyright>DiskTreeScanner</Copyright>
    <!-- The 10.x SDK on this machine builds the net8.0 targets. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
</Project>
