<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line scanner: per-phase timings, totals, peak memory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DiskTreeScanner.Cli</RootNamespace>
    <AssemblyName>DiskTreeScanner.Cli</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DiskTreeScanner.Core\DiskTreeScanner.Core.csproj" />
    <ProjectReference Include="..\..\src\DiskTreeScanner.Ntfs\DiskTreeScanner.Ntfs.csproj" />
  </ItemGroup>

</Project>
