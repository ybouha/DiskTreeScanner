<Project Sdk="Microsoft.NET.Sdk">

  <!-- BenchmarkDotNet on the scan hot paths: FILE record parsing, tree build, aggregation. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DiskTreeScanner.Bench</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DiskTreeScanner.Core\DiskTreeScanner.Core.csproj" />
    <ProjectReference Include="..\..\src\DiskTreeScanner.Ntfs\DiskTreeScanner.Ntfs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The synthetic FILE records of the unit tests. -->
    <Compile Include="..\..\tests\DiskTreeScanner.Tests\Synthetic\RecordBuilder.cs" Link="Synthetic\RecordBuilder.cs" />
  </ItemGroup>

</Project>
