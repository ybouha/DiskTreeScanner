<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinForms shell (no third-party UI library). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DiskTreeScanner.App</RootNamespace>
    <AssemblyName>DiskTreeScanner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Publish: one DiskTreeScanner.exe (about 1.3 MB, precompiled) that runs on the installed .NET 8 Desktop Runtime. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskTreeScanner.Core\DiskTreeScanner.Core.csproj" />
    <ProjectReference Include="..\DiskTreeScanner.Ntfs\DiskTreeScanner.Ntfs.csproj" />
  </ItemGroup>

</Project>
